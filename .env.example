# Optional: private key for the local dev/probe wallet used by scripts/probe.ts.
# Never commit the real value. Generated automatically into .env.local if absent.
PROBE_PRIVATE_KEY=

# Optional: address that receives Builder Code fees in Mode A.
# If unset, a second local test wallet is generated for demo purposes.
NEXT_PUBLIC_BUILDER_ADDRESS=

# Shannon testnet RPC (public default, override only if needed).
NEXT_PUBLIC_SHANNON_RPC_URL=https://dream-rpc.somnia.network
